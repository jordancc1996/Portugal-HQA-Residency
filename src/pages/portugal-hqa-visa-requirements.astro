---
import Layout from '../layouts/Layout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import RequirementsIntakeCta from '../components/RequirementsIntakeCta.astro';

const title = 'Portugal HQA Visa Requirements - Role, Host, and Stay';
const metaTitle = `${title} | Portugal HQA Residency`;
const metaDescription =
  'Portugal HQA visa requirements cover the 2026 role, host, and stay tests. Use this hub for eligibility, documents, and obligations after card approval.';

const requirementItems = [
  {
    label: 'Age',
    text: 'Applicants must be at least 18 years old.',
  },
  {
    label: 'Qualifications',
    text: 'Applicants generally need a university degree or significant professional experience in a specialized or highly qualified field.',
  },
  {
    label: 'Employment or Qualifying Activity',
    text: 'The applicant must have qualifying highly skilled activity in Portugal, supported by the appropriate employment, research, or host arrangement.',
  },
  {
    label: 'Salary Requirements',
    text: 'Where applicable, the position must satisfy the minimum compensation requirements for highly qualified activity in Portugal.',
  },
  {
    label: 'Health Insurance',
    text: 'Applicants must provide appropriate health or travel medical coverage as required for the application and residence process.',
  },
  {
    label: 'Criminal Record',
    text: 'Applicants must provide the required criminal-record documentation and authorize Portuguese authorities to conduct applicable background checks.',
  },
];
---

<Layout title={metaTitle} description={metaDescription}>
  <article>
    <header>
      <HeroBanner
        image="/images/portugal-hqa-visa-requirements-documents.jpg"
        alt="Stone seaward wall and sentry turret above limestone rocks, with open Atlantic water beyond"
        title={title}
        size="compact"
        items={[
          { href: '/', label: 'Home' },
          { href: '/portugal-hqa-visa', label: 'Portugal HQA Visa' },
          { label: 'Requirements' },
        ]}
      />
      <div class="bg-background">
        <div class="site-container py-10 md:py-12">
        <p class="max-w-3xl">
          Portugal HQA visa requirements define who may qualify for residence in Portugal through highly qualified activity. Applicants generally need to meet requirements related to their qualifications, professional activity, Portuguese host or employer, compensation, and supporting documentation. See the
          <a href="/portugal-hqa-visa" class="inline-link">Portugal HQA visa</a>
          guide for an overview of the program.
        </p>
        <section class="mt-10 max-w-3xl">
          <h2>Portugal HQA Visa Requirements</h2>
          <dl class="mt-8">
            {
              requirementItems.map((item) => (
                <div class="mt-10 border-t border-border pt-8 first:mt-0 first:border-t-0 first:pt-0">
                  <dt class="font-sans text-base font-semibold text-text-primary">{item.label}</dt>
                  <dd class="mt-4">{item.text}</dd>
                </div>
              ))
            }
          </dl>
        </section>
        </div>
      </div>
    </header>

    <RequirementsIntakeCta
      source="/portugal-hqa-visa-requirements"
      image="/images/portugal-hqa-visa-portugal-hqa-residency.jpg"
      alt="Lisbon waterfront at dusk with a sailboat on the Tagus and the 25 de Abril Bridge beyond"
      heading="Match your situation to the Portugal HQA requirements"
      copy="Not sure which requirements apply to you? Enter your details and our advisory team can help point you in the right direction."
    />

    <div class="bg-background-alt">
      <div class="site-container py-24 md:py-32">
        <div class="max-w-3xl">
        <section>
          <h2>Documents and Eligibility</h2>
          <p class="mt-6">
            Meeting the general requirements does not mean an application is automatically approved. Applicants must provide evidence demonstrating that both the individual and the proposed activity in Portugal satisfy the applicable requirements.
          </p>
          <p class="mt-4">
            See
            <a href="/portugal-hqa-visa-eligibility" class="inline-link">HQA visa eligibility</a>
            to determine who may qualify, or review the
            <a href="/portugal-hqa-visa-documents" class="inline-link">HQA visa document checklist</a>
            for the supporting evidence typically required.
          </p>
        </section>

        <section class="mt-24">
          <h2>Requirements After Approval</h2>
          <p class="mt-6">
            Requirements continue after a residence permit is issued. Permit holders must comply with Portuguese residence rules and applicable renewal requirements. Changes involving employment, qualifying activity, residence, or extended absences from Portugal may affect renewal.
          </p>
          <p class="mt-4">
            See
            <a href="/portugal-hqa-visa-residency-requirements" class="inline-link">HQA visa residency requirements</a>
            for the requirements that apply after approval.
          </p>
        </section>

        <section class="mt-24">
          <h2>Next Steps</h2>
          <p class="mt-6">
            Once you understand the qualification requirements, review the
            <a href="/portugal-hqa-visa-application" class="inline-link">HQA visa application process</a>,
            <a href="/portugal-hqa-visa-cost" class="inline-link">HQA visa costs</a>, or our guide to the
            <a href="/portugal-article-90-residence-permit" class="inline-link">Portugal Article 90 residence permit</a>.
          </p>
          <p class="mt-4">
            Requirements, salary thresholds, documentation, and immigration procedures can change. Confirm current requirements with AIMA, the appropriate Portuguese consulate, or a qualified immigration professional before filing.
          </p>
        </section>
        </div>
      </div>
    </div>
  </article>
</Layout>
