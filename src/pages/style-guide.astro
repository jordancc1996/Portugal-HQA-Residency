---
import BaseLayout from '../layouts/BaseLayout.astro';
import Amp from '../components/Amp.astro';
---

<BaseLayout
  title="Style guide | Portugal HQA Residency"
  description="Internal style guide for Portugal HQA Residency color, type, and button tokens. This page is not a visa program article."
  noindex={true}
>
  <main class="site-container py-24 md:py-32">
    <h1>Portugal HQA Residency style guide</h1>
    <p class="mt-6 max-w-2xl">
      Temporary token board for visual QA. Brand coral (#C1453B) is the general accent. CTA red (#DC2626) is reserved for the advisor conversion buttons.
    </p>

    <section class="mt-24">
      <h2>Type scale</h2>
      <div class="mt-10 space-y-10">
        <h1>Residence structures that last</h1>
        <h2>Application, documents, and family coverage</h2>
        <h3>What the Highly Qualified Activity route requires</h3>
        <div>
          <h2>Eligibility & Requirements</h2>
          <p class="mt-3">
            Manual helper when a span is required: Costs <Amp /> Investment
          </p>
        </div>
        <p class="max-w-2xl">
          Body copy uses the sans-serif stack at 1rem with relaxed line height and secondary text color. Use this register for explanations, process notes, and supporting detail. Keep sentences direct. Do not rely on the brand color for long passages of text.
        </p>
      </div>
    </section>

    <section class="mt-24">
      <h2>Buttons</h2>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <button type="button" class="btn-primary">Primary action</button>
        <button type="button" class="btn-cta">Advisor conversion</button>
        <button type="button" class="btn-secondary">Secondary action</button>
        <a href="/" class="btn-primary">Primary link</a>
        <a href="/" class="btn-secondary">Secondary link</a>
      </div>
    </section>

    <section class="mt-24">
      <h2>Card</h2>
      <div class="card mt-8 min-h-48 p-8">
        <p class="card-eyebrow">Example</p>
        <h3 class="mt-4">Card surface</h3>
        <p class="mt-3 max-w-xl">
          White background, 16px radius, hairline border, and a soft card shadow.
        </p>
        <a href="/" class="btn-primary mt-8 w-full">Open this surface</a>
      </div>
    </section>
  </main>
</BaseLayout>
