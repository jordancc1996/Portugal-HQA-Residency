---
import Layout from '../layouts/Layout.astro';
import RequirementsIntakeCta from '../components/RequirementsIntakeCta.astro';

const clusters = [
  {
    title: 'Eligibility & Requirements',
    description:
      'Role, qualifications, and host-entity tests that AIMA and consular posts use to decide whether an activity counts as highly qualified.',
    href: '/portugal-hqa-visa-requirements',
    linkLabel: 'Explore your eligibility',
  },
  {
    title: 'Costs & Investment',
    description:
      'Government fees, salary floors, and professional costs. This route is not a capital-investment visa and does not use Golden Visa subscription amounts.',
    href: '/portugal-hqa-visa-cost',
    linkLabel: 'Discuss your residency options',
  },
  {
    title: 'Application Process',
    description:
      'Document assembly, consular or in-country filing, biometrics, and residence-card issuance, in the order most files actually move.',
    href: '/portugal-hqa-visa-application',
    linkLabel: 'Discuss your residency options',
  },
  {
    title: 'Bringing Your Family',
    description:
      'How a spouse and dependent children can be included, what proof of family relationship is required, and when they receive their own residence cards.',
    href: '/portugal-hqa-visa-family',
    linkLabel: 'Discuss your residency options',
  },
];
---

<Layout
  title="Portugal HQA Residency - Highly Qualified Activity"
  description="Portugal HQA Residency explains highly qualified activity residence: the host, the role, family coverage, and the 2026 filing path."
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hero-lisboa-station.webp" type="image/webp" />
  </Fragment>
  <section class="home-hero bg-surface-dark">
    <div class="home-hero__copy">
      <div class="home-hero__content">
        <h1 class="hero-headline min-w-0 w-full font-serif font-medium text-white">
          <span>Residence in Portugal</span>
          <span>for highly qualified work</span>
        </h1>
        <p class="mt-6 w-full min-w-0 text-stone-200">
          The Portugal HQA Residency provides qualified professionals with a pathway to Portuguese residency based on their professional role, the organization supporting them, and the strength of their application.
        </p>
        <div class="mt-10 flex w-full flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a href="/contact" class="btn-cta w-full sm:w-fit">Discuss your residency options</a>
          <a href="/portugal-hqa-visa" class="btn-on-dark w-full sm:w-fit">Explore your eligibility</a>
        </div>
      </div>
    </div>
    <div class="home-hero__media">
      <picture>
        <source type="image/webp" srcset="/images/hero-lisboa-station.webp" />
        <img
          src="/images/hero-lisboa-station.jpg"
          alt="Santa Apolonia station facade in Lisbon, with LISBOA lettering, a clock, and twin towers against a clear blue sky"
          width="642"
          height="1024"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </section>

  <section class="bg-background-alt">
    <div class="site-container max-w-3xl py-24 md:py-32">
      <h2 class="editorial-heading" data-scroll-reveal>What is the Portugal HQA Visa?</h2>
      <p class="mt-6" data-scroll-reveal>
        The
        <a href="/portugal-highly-qualified-activity-visa" class="inline-link">Portugal HQA Visa</a>
        offers non-EU nationals a route to residency built on research and development activity rather than a straightforward capital investment. Instead of purchasing property or parking funds in an investment vehicle, an applicant typically partners with an accredited Portuguese research institution, forms a Portuguese company they own outright, and directs a multi-year R&amp;D project through that company, with the option to commercialize whatever the research produces. Eligibility depends on meeting the program's qualifying criteria for the applicant's role and activity, not on the size of a passive investment.
      </p>
      <a href="/portugal-hqa-visa" class="text-link mt-8" data-scroll-reveal>
        Learn more <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="bg-background">
    <div class="site-container py-24 md:py-32">
      <h2 class="editorial-heading" data-scroll-reveal>Eligibility, cost, process, and family coverage</h2>
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {
          clusters.map((item) => (
            <a href={item.href} class="card cluster-card flex h-full flex-col p-8" data-scroll-reveal>
              <h3>{item.title}</h3>
              <p class="mt-4 flex-1">{item.description}</p>
              <span class="text-link mt-6">
                {item.linkLabel}
                <span class="cluster-card-arrow" aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
      <a href="/contact" class="btn-cta mt-12">Discuss your residency options</a>
    </div>
  </section>

  <RequirementsIntakeCta
    source="/"
    image="/images/portugal-hqa-visa-cta-divider.jpg"
    alt="Lisbon waterfront and hillside streets used on the Portugal HQA residency homepage"
    heading="Match your situation to Portugal HQA residency"
    copy="Not sure whether this route fits your work and household? Enter your details and our advisory team can help point you in the right direction."
  />

  <section class="bg-background-alt">
    <div class="site-container py-24 md:py-32">
      <figure class="w-full min-w-0" data-scroll-reveal>
        <img
          src="/images/university-coimbra-courtyard.jpg"
          alt="Student in traditional academic dress crossing the courtyard at the University of Coimbra, Portugal"
          width="1024"
          height="768"
          decoding="async"
          class="h-auto w-full max-w-full rounded-lg object-cover object-center"
        />
      </figure>
      <h2 class="editorial-heading mt-8" data-scroll-reveal>A Residency Path Rooted in Research</h2>
      <p class="mt-6 max-w-2xl" data-scroll-reveal>
        Portugal's HQA visa is designed around collaboration with the country's universities, not passive investment, connecting qualified professionals to real research activity.
      </p>
    </div>
  </section>

  <section class="bg-background">
    <div class="site-container grid grid-cols-1 gap-10 py-24 md:py-32 lg:grid-cols-12">
      <div class="col-span-full min-w-0 lg:col-span-7">
        <h2 class="editorial-heading" data-scroll-reveal>If the HQA visa is not the right route</h2>
        <p class="mt-6 max-w-xl" data-scroll-reveal>
          HQA is built for qualifying professional activity in Portugal. The Golden Visa is a capital route. The D7 is a passive-income residence permit. Compare HQA with D2, the digital nomad visa, the Tech Visa, and the EU Blue Card when those headings fit the facts better. Use the comparison pages if the role, the capital, or the income profile points to a different file.
        </p>
      </div>
      <div class="col-span-full flex min-w-0 flex-col justify-center gap-4 lg:col-span-5">
        <a href="/portugal-hqa-visa-vs-golden-visa" class="text-link" data-scroll-reveal>
          HQA visa vs Golden Visa <span aria-hidden="true">→</span>
        </a>
        <a href="/portugal-hqa-visa-vs-d7" class="text-link" data-scroll-reveal>
          HQA visa vs D7 <span aria-hidden="true">→</span>
        </a>
        <a href="/portugal-hqa-visa-vs-d2" class="text-link" data-scroll-reveal>
          HQA visa vs D2 <span aria-hidden="true">→</span>
        </a>
        <a href="/portugal-hqa-visa-vs-digital-nomad-visa" class="text-link" data-scroll-reveal>
          HQA visa vs digital nomad visa <span aria-hidden="true">→</span>
        </a>
        <a href="/portugal-hqa-visa-vs-tech-visa" class="text-link" data-scroll-reveal>
          HQA visa vs Tech Visa <span aria-hidden="true">→</span>
        </a>
        <a href="/portugal-hqa-visa-vs-eu-blue-card" class="text-link" data-scroll-reveal>
          HQA visa vs EU Blue Card <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-cta-tint">
    <div class="site-container flex flex-col items-start gap-8 py-24 md:py-32">
      <h2 class="max-w-3xl" data-scroll-reveal>Discuss whether the HQA route fits the role and the household</h2>
      <a href="/contact" class="btn-cta">Discuss your residency options</a>
    </div>
  </section>
</Layout>

<style>
  .home-hero {
    --hero-gutter: max(1.25rem, env(safe-area-inset-left, 0px));
    display: flex;
    flex-direction: column;
    min-height: 85vh;
    background-color: #1c1917;
  }

  .home-hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    min-width: 0;
    padding: 3rem var(--hero-gutter) 4rem;
  }

  .home-hero__content {
    width: 100%;
    max-width: 34rem;
    text-align: start;
  }

  .home-hero__content p {
    max-width: 100%;
  }

  .home-hero__media {
    position: relative;
    order: -1;
    height: 45vh;
    min-height: 16rem;
  }

  .home-hero__media picture {
    position: absolute;
    inset: 1rem;
  }

  .home-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  @media (min-width: 640px) {
    .home-hero__media picture {
      inset: 1.5rem;
    }
  }

  @media (min-width: 768px) {
    .home-hero {
      --hero-gutter: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .home-hero {
      display: grid;
      grid-template-columns: minmax(0, 60%) minmax(0, 40%);
      align-items: stretch;
      min-height: 85vh;
    }

    .home-hero__copy {
      justify-content: center;
      min-height: 85vh;
      height: 100%;
      padding-block: 3rem;
      padding-inline-start: max(2rem, calc(50vw - 45rem + 2rem));
      padding-inline-end: 2rem;
    }

    .home-hero__media {
      order: 0;
      height: auto;
      min-height: 100%;
      align-self: stretch;
    }

    .home-hero__media picture {
      inset: 2rem;
    }
  }
</style>
