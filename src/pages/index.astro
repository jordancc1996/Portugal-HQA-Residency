---
import Layout from '../layouts/Layout.astro';

const clusters = [
  {
    title: 'Eligibility & Requirements',
    description:
      'Role, qualifications, and host-entity tests that AIMA and consular posts use to decide whether an activity counts as highly qualified.',
    href: '/portugal-hqa-visa-requirements',
    linkLabel: 'Explore Your Eligibility',
  },
  {
    title: 'Costs & Investment',
    description:
      'Government fees, salary floors, and professional costs. This route is not a capital-investment visa and does not use Golden Visa subscription amounts.',
    href: '/portugal-hqa-visa-cost',
    linkLabel: 'Discuss Your Residency Options',
  },
  {
    title: 'Application Process',
    description:
      'Document assembly, consular or in-country filing, biometrics, and residence-card issuance, in the order most files actually move.',
    href: '/portugal-hqa-visa-application',
    linkLabel: 'Discuss Your Residency Options',
  },
  {
    title: 'Bringing Your Family',
    description:
      'How a spouse and dependent children can be included, what proof of family relationship is required, and when they receive their own residence cards.',
    href: '/portugal-hqa-visa-family',
    linkLabel: 'Discuss Your Residency Options',
  },
];

const logos = ['Advisory partner', 'Law chamber', 'Relocation group', 'Employer network'];

const stats = [
  { value: '15', unit: 'years', label: 'of immigration advisory work' },
  { value: '8', unit: 'routes', label: 'compared across Portugal residence options' },
  { value: '3', unit: 'generations', label: 'of family filings documented in-house' },
];
---

<Layout
  title="Portugal HQA Residency - Highly Qualified Activity"
  description="Portugal HQA Residency explains highly qualified activity residence: the host, the role, family coverage, and the 2026 filing path."
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hero-lisboa-station.webp" type="image/webp" />
  </Fragment>
  <section class="bg-surface-dark">
    <div class="flex min-h-[85vh] min-w-0 flex-col lg:grid lg:grid-cols-[minmax(0,60%)_minmax(0,40%)]">
      <div class="hero-panel order-2 flex min-w-0 flex-1 flex-col justify-center bg-surface-dark px-5 pr-8 py-12 sm:px-8 lg:order-1 lg:px-16 lg:py-24">
        <h1 class="hero-headline min-w-0 w-full font-serif font-bold tracking-tight text-white">
          <span class="block">Residence in Portugal for</span>
          <span class="block">highly qualified work</span>
        </h1>
        <p class="mt-6 w-full min-w-0 max-w-xl text-stone-200">
          The Portugal HQA Residency provides qualified professionals with a pathway to Portuguese residency based on their professional role, the organization supporting them, and the strength of their application.
        </p>
        <div class="mt-10 flex w-full max-w-xl flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a href="/contact" class="btn-cta w-full sm:w-fit">Discuss Your Residency Options</a>
          <a
            href="/portugal-hqa-visa"
            class="inline-flex w-full max-w-full items-center justify-center rounded-pill border border-white/40 px-6 py-3 font-sans text-sm font-semibold text-white transition-[background-color,border-color,color,transform] duration-150 ease-out hover:border-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-fit"
          >
            Explore Your Eligibility
          </a>
        </div>
      </div>
      <div class="order-1 flex h-[45vh] min-h-[16rem] min-w-0 w-full p-4 sm:p-6 lg:order-2 lg:h-auto lg:min-h-[85vh] lg:p-8">
        <picture class="block h-full w-full min-w-0 max-w-full">
          <source type="image/webp" srcset="/images/hero-lisboa-station.webp" />
          <img
            src="/images/hero-lisboa-station.jpg"
            alt="Santa Apolonia station facade in Lisbon, with LISBOA lettering, a clock, and twin towers against a clear blue sky"
            width="642"
            height="1024"
            fetchpriority="high"
            decoding="async"
            class="h-full w-full max-w-full rounded-lg object-cover object-[center_20%]"
          />
        </picture>
      </div>
    </div>
  </section>

  <section class="bg-background-alt">
    <div class="site-container max-w-3xl py-24 md:py-32">
      <h2>What the HQA visa is</h2>
      <p class="mt-6">
        Portugal issues the
        <a href="/portugal-highly-qualified-activity-visa" class="inline-link">Highly Qualified Activity visa</a>
        (often shortened to HQA) to non-EU nationals who will carry out highly qualified professional activity in the country, typically through a qualifying employment relationship with a Portuguese company or institution. Approval turns on whether the role and the applicant meet the statutory tests, not on buying real estate or parking capital in a fund. Once resident, many families later apply for renewal, permanent residence, or citizenship under the general rules that apply to legal residents.
      </p>
      <p class="mt-4">
        Processing times, salary floors, and documentary lists change. Confirm current AIMA and consular instructions before you file.
      </p>
      <a href="/portugal-hqa-visa" class="text-link mt-8">
        Learn more <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="bg-background">
    <div class="site-container py-24 md:py-32">
      <h2 class="max-w-3xl">Eligibility, cost, process, and family coverage</h2>
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {
          clusters.map((item) => (
            <article class="card cluster-card flex h-full flex-col p-8 transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-[5px] hover:border-brand hover:shadow-[0_12px_32px_rgba(28,25,23,0.10)]">
              <h3>{item.title}</h3>
              <p class="mt-4 flex-1">{item.description}</p>
              <a href={item.href} class="btn-primary mt-auto w-full gap-2">
                {item.linkLabel}
                <span class="cluster-card-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-background-alt">
    <div class="site-container py-24 md:py-32">
      <h2 class="max-w-3xl">Structured files, not a volume sales funnel</h2>
      <p class="mt-6 max-w-2xl">
        Partner marks and the figures below are placeholders. Replace the logos and the numbers after the client confirms what may be shown.
      </p>
      <ul class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4" aria-label="Partner logo placeholders">
        {
          logos.map((name) => (
            <li class="flex h-24 items-center justify-center rounded-md border border-border bg-background grayscale">
              <span class="font-sans text-sm text-text-secondary">{name}</span>
            </li>
          ))
        }
      </ul>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          stats.map((stat) => (
            <div class="card p-8">
              <p class="font-serif text-4xl font-medium text-text-primary md:text-5xl">{stat.value}</p>
              <p class="mt-2 text-sm text-text-secondary">{stat.unit}</p>
              <p class="mt-3">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-background">
    <div class="site-container grid grid-cols-1 gap-10 py-24 md:py-32 lg:grid-cols-12">
      <div class="col-span-full min-w-0 lg:col-span-7">
        <h2>If the HQA visa is not the right route</h2>
        <p class="mt-6 max-w-xl">
          HQA is built for qualifying professional activity in Portugal. The Golden Visa is a capital route. The D7 is a passive-income residence permit. Use the comparison pages if the role, the capital, or the income profile points to a different file.
        </p>
      </div>
      <div class="col-span-full flex min-w-0 flex-col justify-center gap-4 lg:col-span-5">
        <a href="/portugal-hqa-visa-vs-golden-visa" class="text-link">
          HQA visa vs Golden Visa <span aria-hidden="true">→</span>
        </a>
        <a href="/portugal-hqa-visa-vs-d7" class="text-link">
          HQA visa vs D7 <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-cta-tint">
    <div class="site-container flex flex-col items-start gap-8 py-24 md:py-32">
      <h2 class="max-w-3xl">Discuss whether the HQA route fits the role and the household</h2>
      <a href="/contact" class="btn-cta">Discuss Your Residency Options</a>
    </div>
  </section>
</Layout>

<style>
  .hero-headline {
    color: #ffffff;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.025em;
    line-height: 1.15;
    overflow-wrap: break-word;
    word-break: normal;
    max-width: 100%;
  }

  .hero-panel p {
    max-width: min(36rem, 100%);
  }

  @media (min-width: 640px) {
    .hero-headline {
      font-size: clamp(1.75rem, 0.9rem + 2.6vw, 3.75rem);
      line-height: 1.1;
    }
  }
</style>
