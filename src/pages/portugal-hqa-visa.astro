---
import Layout from '../layouts/Layout.astro';
import IntakeForm from '../components/IntakeForm.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import RequirementsIntakeCta from '../components/RequirementsIntakeCta.astro';
import { clusterHubs, glanceSpokes } from '../data/sitemap';

const title = 'Portugal HQA Visa - Highly Qualified Activity Residence';
const metaTitle = `${title} | Portugal HQA Residency`;
const metaDescription =
  'Portugal HQA visa explained for qualified professionals: 2026 eligibility, costs, processing, and family residence. Informational only, not legal advice.';

const audiences = [
  {
    title: 'Researchers',
    text: 'People joining a Portuguese research unit, laboratory, or funded project, where the activity and the host meet the highly qualified tests.',
  },
  {
    title: 'University-affiliated professionals',
    text: 'Academic staff, lecturers, and specialists contracted by a Portuguese university or related institute, when the role is highly qualified activity rather than a student stay.',
  },
  {
    title: 'Highly qualified specialists',
    text: 'Engineers, scientists, clinicians, and other specialists hired by a Portuguese company or institution at or above the published salary floor for the route.',
  },
];

const glance = [
  {
    ...glanceSpokes[0],
    eyebrow: 'Eligibility',
    cta: 'Explore Your Eligibility',
    summary: 'A qualifying role, supporting qualifications, and a Portuguese host. Nationality, criminal-record, and subsistence rules also apply.',
  },
  {
    ...glanceSpokes[1],
    eyebrow: 'Costs',
    cta: 'Discuss Your Residency Options',
    summary: 'State fees plus a salary at or above the legal floor. This is not a capital-investment visa and has no Golden Visa subscription amount.',
  },
  {
    ...glanceSpokes[2],
    eyebrow: 'Timeline',
    cta: 'Discuss Your Residency Options',
    summary: 'Often measured in months at the consulate and at AIMA. Queues change. Confirm the current timeline before you resign a post or move household goods.',
  },
  {
    ...glanceSpokes[3],
    eyebrow: 'Long-term',
    cta: 'Discuss Your Residency Options',
    summary: 'Renewal, permanent residence, and naturalization follow the statutes in force after a period of legal stay. They are separate filings, not automatic upgrades.',
  },
];
---

<Layout title={metaTitle} description={metaDescription}>
  <article>
    <header>
      <div class="relative isolate aspect-[5/4] max-h-[85vh] min-h-[28rem] w-full overflow-hidden text-left sm:aspect-[16/10] sm:min-h-[32rem] lg:aspect-[16/9] lg:min-h-[36rem]">
        <img
          src="/images/portugal-hqa-visa-program.jpg"
          alt="Santander Academic Hall beside a reflecting pool, with lettering on the concrete facade and palms on the slope beyond"
          width="682"
          height="1024"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover object-[center_48%] sm:object-[center_50%] lg:object-[center_52%]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/35 to-black/15" aria-hidden="true"></div>
        <div class="relative z-10 flex h-full min-h-0 w-full flex-col py-10 md:py-14">
          <div class="site-container shrink-0">
            <Breadcrumb
              tone="on-dark"
              items={[{ href: '/', label: 'Home' }, { label: 'Portugal HQA Visa' }]}
            />
          </div>
          <div class="site-container flex min-h-0 w-full min-w-0 flex-1 flex-col items-center justify-center">
            <h1 class="hero-headline mx-auto w-full min-w-0 max-w-4xl text-center font-serif font-bold text-white">
              {title}
            </h1>
          </div>
        </div>
      </div>
      <div class="bg-background">
        <div class="site-container py-24 md:py-32">
          <p class="max-w-3xl" data-scroll-reveal>
            The Portugal HQA visa is a residence permit for non-EU nationals who will perform highly qualified professional activity in Portugal. The official name is the
            <a href="/portugal-highly-qualified-activity-visa" class="inline-link">Portugal Highly Qualified Activity visa</a>.
            It is for people with a qualifying role and a Portuguese host, not for buyers of real estate or holders of passive income alone. Core benefits are lawful residence, work in the qualifying activity, Schengen travel on a Portuguese residence card, and a documented path to longer-term status if the person remains legally resident.
          </p>
        </div>
      </div>
    </header>

    <div class="bg-background-alt">
      <div class="site-container grid grid-cols-1 gap-10 py-24 md:py-32 lg:grid-cols-12">
        <div class="col-span-full min-w-0 lg:col-span-8">
          <section>
            <h2 data-scroll-reveal>Who this is for</h2>
            <p class="mt-6" data-scroll-reveal>
              HQA is a work and activity route. The file stands or falls on whether the job (or the hosted activity) is highly qualified under Portuguese immigration law, and whether the applicant can prove qualifications, a clean record, and a relationship with a host in Portugal. US-based H-1B professionals considering Portuguese residency can read
              <a href="/portugal-hqa-visa-for-h1b-holders" class="inline-link">Portugal HQA Visa for H-1B holders</a>.
              That overlay does not replace the host and role tests below.
            </p>
            <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-12">
              {
                audiences.map((item, index) => (
                  <article
                    class:list={[
                      'card p-8',
                      index === 0 ? 'col-span-full md:col-span-7' : '',
                      index === 1 ? 'col-span-full md:col-span-5' : '',
                      index === 2 ? 'col-span-full' : '',
                    ]}
                    data-scroll-reveal
                  >
                    <h3>{item.title}</h3>
                    <p class="mt-4">{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>
        </div>

        <aside class="col-span-full hidden min-w-0 lg:col-span-4 lg:block">
          <div class="card sticky top-8 p-8">
            <h3>Cluster hubs</h3>
            <ul class="mt-6 space-y-3">
              {
                clusterHubs.map((item) => (
                  <li>
                    <a href={item.href} class="text-link">
                      {item.label} <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </div>

    <RequirementsIntakeCta
      source="/portugal-hqa-visa"
      image="/images/portugal-hqa-visa-overview-cta-divider.jpg"
      alt="Portuguese university campus and grounds used on the Portugal HQA visa overview"
      heading="Match your role and host to the Portugal HQA visa"
      copy="Not sure whether this permit fits the job and the household? Enter your details and our advisory team can help point you in the right direction."
    />

    <div class="bg-background-alt">
      <div class="site-container grid grid-cols-1 gap-10 py-24 md:py-32 lg:grid-cols-12">
        <div class="col-span-full min-w-0 lg:col-span-8">
          <section>
            <h2 data-scroll-reveal>At a glance</h2>
            <p class="mt-6" data-scroll-reveal>
              Use these summaries as a map. Each item opens the full page for tests, figures, and caveats. Figures change. Confirm current AIMA and consular instructions before you file.
            </p>
            <dl class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
              {
                glance.map((item) => (
                  <div class="card flex h-full flex-col p-8" data-scroll-reveal>
                    <p class="card-eyebrow">{item.eyebrow}</p>
                    <dt>
                      <a href={item.href} class="mt-4 block font-serif text-2xl font-medium text-text-primary">
                        {item.label}
                      </a>
                    </dt>
                    <dd class="mt-4 flex-1">{item.summary}</dd>
                    <dd class="mt-auto pt-6">
                      <a href={item.href} class="btn-primary w-full">
                        {item.cta}
                      </a>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </section>

          <section class="mt-24">
            <h2 data-scroll-reveal>How an HQA file is assembled</h2>
            <p class="mt-6" data-scroll-reveal>
              Most employed files start with a Portuguese contract or binding offer, then evidence that the activity meets
              <a href="/portugal-hqa-visa-requirements" class="inline-link"> HQA visa requirements</a>
              for the role, the qualifications, and the host. Parallel to that, the applicant gathers identity, criminal-record, and subsistence documents. The
              <a href="/portugal-hqa-visa-application" class="inline-link"> HQA visa application</a>
              then moves through a consular post or an in-country AIMA path, depending on where the person is when the file is lodged.
            </p>
            <p class="mt-4" data-scroll-reveal>
              Budget for
              <a href="/portugal-hqa-visa-cost" class="inline-link"> HQA visa cost</a>
              as state fees plus a salary at or above the legal floor, and for professional work if you instruct
              <a href="/portugal-hqa-visa-lawyer" class="inline-link"> an HQA visa lawyer or consultant</a>
              to assemble translations, legalizations, and the host pack. There is no real-estate purchase and no fund subscription of the kind used for the
              <a href="/portugal-hqa-visa-vs-golden-visa" class="inline-link"> HQA visa vs Golden Visa</a>
              comparison. If the person will live on foreign pensions or remote income without a qualifying Portuguese role, the
              <a href="/portugal-hqa-visa-vs-d7" class="inline-link"> HQA visa vs D7</a>
              comparison is the better starting point.
            </p>
            <p class="mt-4" data-scroll-reveal>
              A spouse and dependent children are not automatic. Coverage, evidence of family relationship, and card issuance are set out on
              <a href="/portugal-hqa-visa-family" class="inline-link"> bringing family on the HQA visa</a>.
              Researchers and academic hires should also read the
              <a href="/portugal-research-visa" class="inline-link">Portugal research visa</a>
              host pages before treating a grant letter or teaching contract as enough on its own.
            </p>
          </section>

          <nav class="mt-16 lg:hidden" aria-label="Cluster hubs">
            <div class="card p-8" data-scroll-reveal>
              <h3>Cluster hubs</h3>
              <ul class="mt-6 space-y-3">
                {
                  clusterHubs.map((item) => (
                    <li>
                      <a href={item.href} class="text-link">
                        {item.label} <span aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </nav>
        </div>

        <aside class="col-span-full hidden min-w-0 lg:col-span-4 lg:block">
          <div class="card sticky top-8 p-8">
            <h3>Cluster hubs</h3>
            <ul class="mt-6 space-y-3">
              {
                clusterHubs.map((item) => (
                  <li>
                    <a href={item.href} class="text-link">
                      {item.label} <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </div>

    <section class="bg-cta-tint">
      <div class="site-container flex flex-col items-start gap-6 py-24 md:py-32">
        <h2 class="max-w-3xl" data-scroll-reveal>Review the role, the host, and the household before you file</h2>
        <p class="max-w-2xl" data-scroll-reveal>
          This page is informational. It is not legal, tax, or immigration advice. An advisor can map the contract and the family facts to the current AIMA and consular list.
        </p>
        {/* TODO: no backend yet */}
        <IntakeForm source="/portugal-hqa-visa" simple />
      </div>
    </section>
  </article>
</Layout>
