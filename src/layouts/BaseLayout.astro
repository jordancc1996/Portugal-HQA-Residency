---
import '../styles/global.css';
import JsonLd from '../components/JsonLd.astro';
import {
  breadcrumbListJsonLd,
  canonicalPath,
  canonicalUrl,
  faqPageJsonLd,
  organizationJsonLd,
  type Crumb,
  type FaqEntry,
} from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  faqItems?: FaqEntry[];
}

const { title, description, noindex = false, breadcrumbs, faqItems } = Astro.props;
const path = canonicalPath(Astro.url.pathname);
const canonical = canonicalUrl(path);
const fontHref =
  'https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap';
const crumbItems: Crumb[] =
  breadcrumbs ??
  (path === '/'
    ? [{ href: '/', label: 'Home' }]
    : [
        { href: '/', label: 'Home' },
        { href: path, label: title.replace(/ \| Portugal HQA Residency$/, '') },
      ]);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontHref} />
    <link id="site-fonts" rel="stylesheet" href={fontHref} media="print" />
    <script is:inline>
      (function () {
        var el = document.getElementById('site-fonts');
        if (!el) return;
        el.addEventListener('load', function () {
          el.media = 'all';
        });
        setTimeout(function () {
          el.media = 'all';
        }, 1200);
      })();
    </script>
    <noscript>
      <link rel="stylesheet" href={fontHref} />
    </noscript>
    <title>{title}</title>
    {!noindex && <JsonLd data={organizationJsonLd()} />}
    <JsonLd data={breadcrumbListJsonLd(crumbItems, path)} />
    {faqItems && faqItems.length > 0 && <JsonLd data={faqPageJsonLd(faqItems)} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
