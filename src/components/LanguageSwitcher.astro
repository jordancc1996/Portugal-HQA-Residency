---
import { languages } from '../data/languages';

interface Props {
  id: string;
  variant?: 'header' | 'mobile';
}

const { id, variant = 'header' } = Astro.props;
const inHeader = variant === 'header';
---

<div class="lang-switch relative z-[60]" id={id}>
  {
    inHeader && (
      <details class="lang-switch__dropdown relative">
        <summary class="lang-switch__current flex min-h-11 min-w-11 cursor-pointer list-none items-center gap-1 px-3 font-sans text-xs font-semibold uppercase tracking-wide text-stone-600 focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none">
          <span data-lang-current>EN</span>
          <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.25"></path>
          </svg>
        </summary>
        <div
          class="absolute end-0 z-50 mt-2 min-w-16 bg-stone-100 px-1 py-1"
          role="menu"
          aria-label="Language"
        >
          {
            languages.map((language) => (
              <button
                type="button"
                role="menuitem"
                data-lang={language.code}
                aria-current={language.code === 'en' ? 'true' : undefined}
                class="block min-h-11 w-full px-3 text-start font-sans text-xs font-semibold uppercase tracking-wide text-stone-600 transition-colors duration-150 ease-out hover:text-stone-800 focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none aria-[current=true]:text-brand"
              >
                {language.label}
              </button>
            ))
          }
        </div>
      </details>
    )
  }
  {
    !inHeader && (
  <div
    class="inline-flex items-center bg-stone-100 px-1 py-1"
    role="menu"
    aria-label="Language"
    aria-orientation="horizontal"
  >
    {
      languages.map((language, index) => (
        <button
          type="button"
          role="menuitem"
          data-lang={language.code}
          aria-current={language.code === 'en' ? 'true' : undefined}
          class:list={[
            'inline-flex min-h-11 items-center px-3 font-sans text-xs font-semibold uppercase tracking-wide text-stone-600 transition-colors duration-150 ease-out hover:text-stone-800 focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none aria-[current=true]:text-brand',
            index > 0 && 'border-s border-stone-300',
          ]}
        >
          {language.label}
        </button>
      ))
    }
  </div>
    )
  }
</div>

<style>
  .lang-switch__dropdown summary::-webkit-details-marker {
    display: none;
  }
</style>
