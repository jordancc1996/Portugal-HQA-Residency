---
import { processCluster } from '../data/sitemap';

interface Props {
  current: string;
}

const { current } = Astro.props;
---

<nav aria-label="Process cluster" class="border-t border-border pt-10">
  <p class="font-sans text-sm font-semibold text-text-primary">In this cluster</p>
  <ul class="mt-4 flex list-none flex-col gap-3 p-0">
    {
      processCluster.map((item) => (
        <li>
          {item.href === current ? (
            <span class="text-link" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="text-link">
              {item.label} <span aria-hidden="true">→</span>
            </a>
          )}
        </li>
      ))
    }
    <li>
      <a href="/portugal-hqa-visa-requirements" class="text-link">
        Requirements cluster <span aria-hidden="true">→</span>
      </a>
    </li>
    <li>
      <a href="/portugal-hqa-visa-documents" class="text-link">
        Document checklist <span aria-hidden="true">→</span>
      </a>
    </li>
    <li>
      <a href="/portugal-hqa-visa-residency-requirements" class="text-link">
        After approval <span aria-hidden="true">→</span>
      </a>
    </li>
    <li>
      <a href="/portugal-hqa-visa-permanent-residency" class="text-link">
        Permanent residency <span aria-hidden="true">→</span>
      </a>
    </li>
    <li>
      <a href="/portugal-hqa-visa" class="text-link">
        Portugal HQA visa guide <span aria-hidden="true">→</span>
      </a>
    </li>
  </ul>
</nav>
