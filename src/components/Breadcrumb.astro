---
import type { Crumb } from '../lib/seo';

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 font-sans text-sm text-text-secondary">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && (
            <span aria-hidden="true" class="text-border">
              /
            </span>
          )}
          {item.href ? (
            <a href={item.href} class="transition-colors duration-150 ease-out hover:text-text-primary">
              {item.label}
            </a>
          ) : (
            <span class="text-text-secondary" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
